<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#111111">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-192.png">
<title>RentCar Manager</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#f4f4f5;color:#18181b}
header{background:#111;color:white;padding:18px 16px;position:sticky;top:0;z-index:2}header h1{margin:0;font-size:22px}header p{margin:4px 0 0;color:#bbb;font-size:13px}
main{max-width:760px;margin:auto;padding:14px 14px 90px}.panel{background:white;border:1px solid #ddd;border-radius:16px;padding:15px;margin-bottom:12px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:#f4f4f5;border-radius:12px;padding:11px}.stat small{color:#666}.stat b{display:block;font-size:20px;margin-top:2px}
nav{position:fixed;bottom:0;left:0;right:0;background:white;border-top:1px solid #ddd;display:grid;grid-template-columns:repeat(4,1fr);z-index:3}nav button{border:0;background:white;padding:10px 3px;font-size:12px;color:#555}nav button.active{font-weight:800;color:#111}
.page{display:none}.page.active{display:block}button,input,select{font:inherit}button{cursor:pointer}.btn{border:0;border-radius:10px;padding:11px 14px;font-weight:700}.primary{background:#111;color:#fff}.secondary{background:#eee;color:#111}.danger{background:#fee2e2;color:#991b1b}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.field label{display:block;font-size:12px;font-weight:700;margin-bottom:4px}.field input,.field select{width:100%;padding:11px;border:1px solid #ccc;border-radius:10px;background:white}
.row{display:flex;justify-content:space-between;gap:10px;align-items:center;border-bottom:1px solid #eee;padding:12px 0}.row:last-child{border:0}.muted{font-size:13px;color:#666}.badge{display:inline-block;border-radius:999px;padding:4px 8px;font-size:11px;background:#e5e7eb}.available{background:#dcfce7;color:#166534}.rented{background:#fee2e2;color:#991b1b}
.actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.empty{text-align:center;color:#777;padding:20px}.money{font-weight:800}
@media(max-width:480px){.grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.stats .stat:last-child{grid-column:span 2}}
</style>
</head>
<body>
<header><h1>🚗 RentCar Manager</h1><p>Control de vehículos y alquileres</p></header>
<main>
<section id="home" class="page active">
<div class="panel"><div class="stats">
<div class="stat"><small>Vehículos</small><b id="sCars">0</b></div>
<div class="stat"><small>Rentados</small><b id="sRented">0</b></div>
<div class="stat"><small>Ingresos pagados</small><b id="sIncome">RD$0</b></div>
</div></div>
<div class="panel"><h3>📋 Alquileres activos</h3><div id="active"></div></div>
</section>

<section id="cars" class="page">
<div class="panel"><h3>🚘 Mis vehículos</h3>
<form id="carForm"><div class="grid">
<div class="field"><label>Vehículo</label><input id="carName" required placeholder="Hyundai Accent"></div>
<div class="field"><label>Placa</label><input id="carPlate" placeholder="A000000"></div>
</div><div class="actions"><button class="btn primary">Agregar vehículo</button></div></form></div>
<div class="panel"><div id="carList"></div></div>
</section>

<section id="rentals" class="page">
<div class="panel"><h3>➕ Nuevo alquiler</h3>
<form id="rentForm"><div class="grid">
<div class="field"><label>Cliente</label><input id="client" required></div>
<div class="field"><label>Teléfono</label><input id="phone"></div>
<div class="field"><label>Vehículo</label><select id="vehicle" required></select></div>
<div class="field"><label>Precio por día (RD$)</label><input id="price" type="number" min="0" required></div>
<div class="field"><label>Fecha de salida</label><input id="start" type="date" required></div>
<div class="field"><label>Fecha de devolución</label><input id="end" type="date" required></div>
<div class="field"><label>Abono (RD$)</label><input id="paid" type="number" min="0" value="0"></div>
<div class="field"><label>Depósito (RD$)</label><input id="deposit" type="number" min="0" value="0"></div>
</div><p id="calc" class="muted">Selecciona fechas y precio.</p>
<button class="btn primary" type="submit">Guardar alquiler</button></form></div>
<div class="panel"><h3>📚 Historial</h3><div id="history"></div></div>
</section>

<section id="clients" class="page">
<div class="panel"><h3>👤 Clientes</h3><div id="clientsList"></div></div>
</section>
</main>
<nav>
<button data-page="home" class="active">🏠<br>Inicio</button>
<button data-page="cars">🚘<br>Carros</button>
<button data-page="rentals">📋<br>Alquiler</button>
<button data-page="clients">👤<br>Clientes</button>
</nav>
<script>
const KEY="rentcar_manager_v1";
let db=JSON.parse(localStorage.getItem(KEY)||'{"cars":[],"rentals":[]}');
const $=id=>document.getElementById(id);
const money=n=>"RD$"+Number(n||0).toLocaleString("es-DO");
const dayCount=(a,b)=>Math.max(0,Math.round((new Date(b+"T00:00:00Z")-new Date(a+"T00:00:00Z"))/86400000));
function save(){localStorage.setItem(KEY,JSON.stringify(db));render()}
function rentalActive(r){return r.status==="active"}
function render(){
  $("sCars").textContent=db.cars.length;
  $("sRented").textContent=db.rentals.filter(rentalActive).length;
  $("sIncome").textContent=money(db.rentals.reduce((s,r)=>s+Number(r.paid||0),0));
  $("vehicle").innerHTML='<option value="">Selecciona vehículo</option>'+db.cars.map((c,i)=>`<option value="${i}">${esc(c.name)} · ${esc(c.plate||"Sin placa")}</option>`).join("");
  $("carList").innerHTML=db.cars.length?db.cars.map((c,i)=>{
    const r=db.rentals.find(x=>rentalActive(x)&&x.carId===i);
    return `<div class="row"><div><b>🚗 ${esc(c.name)}</b><div class="muted">${esc(c.plate||"Sin placa")}</div></div><span class="badge ${r?"rented":"available"}">${r?"Rentado":"Disponible"}</span></div>`;
  }).join(""):'<div class="empty">No hay vehículos registrados.</div>';
  const active=db.rentals.filter(rentalActive);
  $("active").innerHTML=active.length?active.map((r,i)=>`<div class="row"><div><b>${esc(r.carName)}</b><div>${esc(r.client)} · ${esc(r.phone||"Sin teléfono")}</div><div class="muted">${r.start} → ${r.end} · ${r.days} día(s)</div><div class="money">Pendiente: ${money(r.total-r.paid)}</div></div><button class="btn secondary" onclick="finish('${r.id}')">Devolver</button></div>`).join(""):'<div class="empty">No hay alquileres activos.</div>';
  $("history").innerHTML=db.rentals.length?db.rentals.map(r=>`<div class="row"><div><b>${esc(r.client)}</b> · ${esc(r.carName)}</div><div class="muted">${r.start} → ${r.end}<br>${r.days} día(s) · Total ${money(r.total)} · Pagado ${money(r.paid)} · Pendiente ${money(r.total-r.paid)} · ${r.status==="active"?"ACTIVO":"DEVUELTO"}</div></div>`).join(""):'<div class="empty">Sin historial.</div>';
  const map={};db.rentals.forEach(r=>{map[r.client]=(map[r.client]||[]).concat(r)});
  $("clientsList").innerHTML=Object.keys(map).length?Object.entries(map).map(([name,rs])=>`<div class="row"><div><b>👤 ${esc(name)}</b><div class="muted">${esc(rs[0].phone||"Sin teléfono")}</div></div><span class="badge">${rs.length} alquiler(es)</span></div>`).join(""):'<div class="empty">No hay clientes.</div>';
}
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
window.finish=id=>{const r=db.rentals.find(x=>x.id===id);if(r){r.status="returned";save()}};
document.querySelectorAll("nav button").forEach(b=>b.onclick=()=>{document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));document.querySelectorAll("nav button").forEach(x=>x.classList.remove("active"));$(b.dataset.page).classList.add("active");b.classList.add("active")});
$("carForm").onsubmit=e=>{e.preventDefault();db.cars.push({name:$("carName").value.trim(),plate:$("carPlate").value.trim()});e.target.reset();save()};
["start","end","price","paid"].forEach(id=>$(id).oninput=()=>{const d=dayCount($("start").value,$("end").value),p=Number($("price").value)||0,paid=Number($("paid").value)||0;$("calc").textContent=d?`Días: ${d} · Total: ${money(d*p)} · Pendiente: ${money(d*p-paid)}`:"Selecciona fechas válidas."});
$("rentForm").onsubmit=e=>{e.preventDefault();const ci=$("vehicle").value,a=$("start").value,b=$("end").value,d=dayCount(a,b);if(ci===""||d<=0){alert("Selecciona vehículo y fechas válidas.");return}const p=Number($("price").value)||0,paid=Number($("paid").value)||0;db.rentals.unshift({id:Date.now().toString(),client:$("client").value.trim(),phone:$("phone").value.trim(),carId:Number(ci),carName:db.cars[ci].name,start:a,end:b,days:d,price:p,total:d*p,paid,deposit:Number($("deposit").value)||0,status:"active"});e.target.reset();save();document.querySelector('[data-page="home"]').click()};
render();
if("serviceWorker" in navigator) navigator.serviceWorker.register("sw.js").catch(()=>{});
</script>
</body>
</html>
